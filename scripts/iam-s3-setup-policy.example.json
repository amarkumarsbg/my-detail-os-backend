{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MY DETAIL OSBucketConfigForSetupScript",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:GetBucketPolicy",
        "s3:PutPublicAccessBlock",
        "s3:GetPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME"
    },
    {
      "Sid": "MY DETAIL OSObjectRW",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME/avatars/*",
        "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME/job-cards/*",
        "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME/branding/*"
      ]
    },
    {
      "Sid": "MY DETAIL OSListPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["avatars/*", "job-cards/*", "branding/*"]
        }
      }
    }
  ]
}
